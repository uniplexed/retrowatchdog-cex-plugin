# The CeX plugin's own environment. Two values are required, the Algolia app
# id and search key (README, "Getting the Algolia key"); the rest is optional,
# since the three shops, their indexes and their category lists are compiled
# in.
#
# For a local run, copy this file to `.env` and export its values. In a
# RetroWatchdog deployment the same content goes in `.env.cex` beside the
# app's `.env`, which compose reads with `required: false`.

# The port this process listens on, inside the container. The compose network
# reaches it by service name and publishes no host port.
# PORT=8000

# The categories each country is swept in, comma separated. These MUST be
# verbatim `categoryFriendlyName` facet strings — a plausible-looking guess
# matches nothing at all, silently, and reads exactly like a category the shop
# emptied. The live facet lists are recorded in
# fixtures/country-categories-2026-09-03.md. Unset means the compiled list in
# src/config.ts, the curated retro scope.
# CEX_UK_CATEGORIES=Super NES Software,Nintendo 64 Software
# CEX_ES_CATEGORIES=Super NES Juegos
# CEX_IE_CATEGORIES=Super NES Software

# The Algolia index per country. Changing one points a source at another
# country's catalogue, which the app has no way to detect.
# CEX_UK_INDEX=prod_cex_uk
# CEX_ES_INDEX=prod_cex_es
# CEX_IE_INDEX=prod_cex_ie

# REQUIRED. CeX's Algolia application id and search-only key, which its own
# website sends to every browser. This plugin ships without them: read them
# off the site yourself (README, "Getting the Algolia key"). Without both,
# /health reports configured: false and the app will not enable the shops.
CEX_ALGOLIA_APP_ID=
CEX_ALGOLIA_API_KEY=
# CEX_ALGOLIA_HOST=https://search.webuy.io

# The cadence this plugin PROPOSES in its manifest. The app schedules from what
# was approved, so changing either needs a re-approval in Settings → Plugins.
# `CEX_TRACKED_REFRESH_HOURS` must be a whole number from 1 to 168.
# CEX_SYNC_CRON=0 3 * * *
# CEX_TRACKED_REFRESH_HOURS=4

# How many box ids one refresh query may name. 100 was accepted live on
# 2026-09-17 (a 2,694-character filter); the app hands this service up to 200
# per call, so the default splits that into two queries rather than betting on
# a length nobody has measured. Lower it if CeX ever starts refusing one.
# CEX_IDS_PER_QUERY=100

# How long one outbound Algolia call may take. Keep it under the app's own
# ADAPTER_TIMEOUT_MS (8000): a call this process lets run longer than the app
# waits is a call whose result nobody reads.
# CEX_TIMEOUT_MS=6000
